import os
from pathlib import Path

configfile: os.path.join(workflow.basedir, "config/config.yaml")

INPUT_FASTA = config.get("input_fasta", None)
if INPUT_FASTA is None:
    raise ValueError(
        "ERROR: You must provide an input FASTA file or directory.\n"
        "Example: ./run_stage1.sh /path/to/sequences.fasta"
    )

INPUT_FASTA = os.path.abspath(INPUT_FASTA)
if not os.path.exists(INPUT_FASTA):
    raise ValueError(f"ERROR: Input path does not exist:\n{INPUT_FASTA}")

IDENTITY = config.get("identity", None)
RESIDUES = config.get("residues", None)
PFAM     = config.get("pfam",     None)
EC       = config.get("ec",       None)
BASE_DIR = workflow.basedir
OUT_DIR  = config.get("out_dir", "data/stage1")
LOG_DIR  = config.get("log_dir", "logs/stage1")
SCRIPTS_DIR = os.path.join(BASE_DIR, "scripts")

PFAM_DIR = os.path.join(BASE_DIR, "external/pfam")
PFAM_DB  = os.path.join(PFAM_DIR, "Pfam-A.hmm")

CLEAN_DIR = os.path.join(BASE_DIR, "external/CLEAN")

for d in [OUT_DIR, LOG_DIR]:
    Path(d).mkdir(parents=True, exist_ok=True)


rule all:
    input:
        os.path.join(OUT_DIR, "nonredundant.fasta"),
        os.path.join(OUT_DIR, "clustering_report.tsv"),
        os.path.join(OUT_DIR, "motif_report.tsv"),
        os.path.join(OUT_DIR, "pfam_report.tsv"),
        os.path.join(OUT_DIR, "ec_report.tsv"),

rule setup_pfam:
    output:
        sentinel=os.path.join(PFAM_DIR, ".setup_done"),
    log:
        os.path.join(LOG_DIR, "setup_pfam.log"),
    params:
        script=os.path.join(SCRIPTS_DIR, "setup_pfam.sh"),
        pfam_dir=PFAM_DIR,
    shell:
        r"""
        bash {params.script} {params.pfam_dir} > {log} 2>&1
        """

rule setup_clean:
    output:
        sentinel=os.path.join(CLEAN_DIR, ".setup_done"),
    log:
        os.path.join(LOG_DIR, "setup_clean.log"),
    params:
        script=os.path.join(SCRIPTS_DIR, "setup_clean.sh"),
        clean_dir=CLEAN_DIR,
    shell:
        r"""
        export LD_LIBRARY_PATH="${{CONDA_PREFIX}}/lib:${{LD_LIBRARY_PATH:-}}"
        bash {params.script} {params.clean_dir} > {log} 2>&1
        """

def cluster_inputs(wildcards):
    inputs = {"fasta": INPUT_FASTA}
    if PFAM is not None:
        inputs["pfam_sentinel"] = os.path.join(PFAM_DIR, ".setup_done")
    if EC is not None:
        inputs["clean_sentinel"] = os.path.join(CLEAN_DIR, ".setup_done")
    return inputs

rule cluster_sequences:
    input:
        unpack(cluster_inputs),
    output:
        nonredundant   = os.path.join(OUT_DIR, "nonredundant.fasta"),
        cluster_report = os.path.join(OUT_DIR, "clustering_report.tsv"),
        motif_report   = os.path.join(OUT_DIR, "motif_report.tsv"),
        pfam_report    = os.path.join(OUT_DIR, "pfam_report.tsv"),
        ec_report      = os.path.join(OUT_DIR, "ec_report.tsv"),
    log:
        os.path.join(LOG_DIR, "cluster_sequences.log"),
    params:
        script        = os.path.join(SCRIPTS_DIR, "cluster_sequences.py"),
        identity_arg  = (f"--identity {IDENTITY}" if IDENTITY is not None else ""),
        residues_arg  = (f"--residues {RESIDUES!r}" if RESIDUES is not None else ""),
        pfam_arg      = (f"--pfam {PFAM}" if PFAM is not None else ""),
        pfam_db_arg   = (f"--pfam_db {PFAM_DB}" if PFAM is not None else ""),
        ec_arg        = (f"--ec {EC}" if EC is not None else ""),
        clean_dir_arg = (f"--clean_dir {CLEAN_DIR}" if EC is not None else ""),
    threads:
        workflow.cores
    shell:
        r"""
        export LD_LIBRARY_PATH="${{CONDA_PREFIX}}/lib:${{LD_LIBRARY_PATH:-}}"
        python {params.script} \
            --input          {input.fasta} \
            --nonredundant   {output.nonredundant} \
            --cluster_report {output.cluster_report} \
            --motif_report   {output.motif_report} \
            --pfam_report    {output.pfam_report} \
            --ec_report      {output.ec_report} \
            {params.identity_arg} \
            {params.residues_arg} \
            {params.pfam_arg} \
            {params.pfam_db_arg} \
            {params.ec_arg} \
            {params.clean_dir_arg} \
            --threads        {threads} \
            2> {log}
        """
