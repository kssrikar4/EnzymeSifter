rule run_enzymm:
    input:
        pdb=lambda wc: os.path.join(PDB_DIR, f"{wc.pdb}.pdb"),
    output:
        tsv=os.path.join(DATA_DIR, "enzymm/{pdb}.tsv"),
    log:
        os.path.join(LOG_DIR, "enzymm/{pdb}.log"),
    shell:
        r"""
        enzymm \
            --input {input.pdb} \
            --output {output.tsv} \
            --verbose > {log} 2>&1
        """


# Collect which PDBs had at least 1 EnzyMM hit
checkpoint collect_enzymm_hits:
    input:
        expand(os.path.join(DATA_DIR, "enzymm/{pdb}.tsv"), pdb=PDBS),
    output:
        hitlist=os.path.join(DATA_DIR, "enzymm/hit_pdbs.txt"),
    run:
        hits = []
        for tsv_path in input:
            pdb_name = os.path.splitext(os.path.basename(tsv_path))[0]
            has_hit = False
            with open(tsv_path) as fh:
                for line in fh:
                    # Skip comment lines and the header
                    if line.startswith("#"):
                        continue
                    if line.startswith("query_id"):
                        continue
                    # Any remaining non-empty line is a data row
                    if line.strip():
                        has_hit = True
                        break
            if has_hit:
                hits.append(pdb_name)
        hits.sort()
        with open(output.hitlist, "w") as out:
            for h in hits:
                out.write(h + "\n")


