def tree_clades_png_inputs(wildcards):
    inputs = {
        "tree":     os.path.join(DATA_DIR, "trees/nj_tree.nwk"),
        "clades":   os.path.join(DATA_DIR, "clades/clade_assignments.tsv"),
        "hit_list": os.path.join(DATA_DIR, "enzymm/hit_pdbs.txt"),
    }
    if DO_FILTER:
        inputs["representatives"] = os.path.join(PRED_DIR, "clade_representatives.tsv")
    return inputs

rule tree_clades_png:
    input:
        unpack(tree_clades_png_inputs),
    output:
        png=os.path.join(DATA_DIR, "trees/nj_tree_clades.png"),
    log:
        os.path.join(LOG_DIR, "tree_clades_png.log"),
    params:
        script=os.path.join(SCRIPTS_DIR, "render_tree_png.py"),
        rep_arg=lambda wildcards, input: (
            f"--representatives {input.representatives}" if DO_FILTER else ""
        ),
    shell:
        r"""
        python {params.script} \
            {input.tree} {output.png} \
            --dpi 300 \
            --clades {input.clades} \
            --hit_list {input.hit_list} \
            {params.rep_arg} \
            2> {log}
        """

rule select_representatives:
    input:
        clades=os.path.join(DATA_DIR, "clades/clade_assignments.tsv"),
        filter_done=os.path.join(PRED_DIR, ".filter_done"),
        hit_list=os.path.join(DATA_DIR, "enzymm/hit_pdbs.txt"),
    output:
        tsv=os.path.join(PRED_DIR, "clade_representatives.tsv"),
    log:
        os.path.join(LOG_DIR, "clades/select_representatives.log"),
    params:
        script=os.path.join(SCRIPTS_DIR, "select_representatives.py"),
        pred_dir=PRED_DIR,
        spec_args=" ".join(
            f"--{flag} {val}" for flag, val in FILTER_SPECS.items()
        ),
    shell:
        r"""
        filtered=$(ls {params.pred_dir}/*_filtered.tsv 2>/dev/null || true)
        if [ -z "$filtered" ]; then
            echo -e "clade_id\tID\tscore\tn_eligible_in_clade\tn_members_in_clade" \
                > {output.tsv}
            echo "[INFO] No *_filtered.tsv found — wrote empty representatives TSV." \
                > {log}
        else
            python {params.script} \
                --clades {input.clades} \
                --hit_list {input.hit_list} \
                --filtered $filtered \
                --output {output.tsv} \
                {params.spec_args} \
                2> {log}
        fi
        """

